/*
 * Nextflow Configuration for TAR Extraction
 */

// Enable Wave and Fusion for S3 access
wave {
    enabled = true
}

fusion {
    enabled = true
}

// Process configuration
process {
    // Use Ubuntu container with tar utility
    container = 'ubuntu:22.04'
    
    // Resource defaults
    cpus = 2
    memory = '4 GB'
    
    errorStrategy = 'retry'
    maxRetries = 2
}

// AWS configuration
aws {
    region = 'ap-southeast-1'
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
}

// Manifest
manifest {
    name = 'tar-extraction-pipeline'
    description = 'Extract tar files from S3'
    author = 'Seqera AI'
    version = '1.0.0'
    nextflowVersion = '>=25.04.0'
}
