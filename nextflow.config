/*
 * Nextflow Configuration for TAR Extraction
 */

// Enable Wave for containers, but DISABLE Fusion for large file handling
wave {
    enabled = true
}

fusion {
    enabled = false  // Disabled - Fusion streaming may cause issues with large tar files
}

// Process configuration
process {
    // Use Amazon Linux container with tar and AWS CLI pre-installed
    container = 'amazonlinux:2023'
    
    // Resource defaults - increased for large file handling
    cpus = 4
    memory = '8 GB'
    
    // Retry strategy
    errorStrategy = 'retry'
    maxRetries = 2
    maxErrors = 3
    
    // Ensure AWS CLI is available
    beforeScript = 'yum install -y tar gzip || true'
}

// AWS configuration
aws {
    region = 'ap-southeast-1'
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
}

// Manifest
manifest {
    name = 'tar-extraction-pipeline'
    description = 'Extract tar files from S3'
    author = 'Seqera AI'
    version = '1.0.0'
    nextflowVersion = '>=25.04.0'
}
